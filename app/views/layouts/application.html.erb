<!DOCTYPE html>
<html lang="en-GB" dir="ltr">
  <head>
    <script src="https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?flags=gated&unknown=polyfill"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/phaser/3.90.0/phaser.min.js" integrity="sha384-AvQiDMZAVLda3VtAoU5MCfBz8pzXhteb2CiUJeKBmPlWzpXj1uJ96Km11+YuFNu/" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/plotly.js-dist@3.5.1/plotly.js" integrity="sha384-V8CRSGT6hfYjmal2R2YxAFKCGRnd9vWyPf7cATUyn77/6UuQ4TXYaNw1kJVGty6q" crossorigin="anonymous"></script>
    <%# Page metadata (using helper methods defined in ApplicationHelper) -%>
    <%- site_name_text = site_name -%>
    <%- specific_page_title = page_specific_title(@article) -%>
    <%- full_page_title = page_title(specific_page_title) -%>
    <%- page_description = meta_description(@article) -%>
    <%- page_keywords = meta_keywords(@article) -%>
    <%- content_type = page_type(@article) -%>
    <%- current_url = canonical_url(@article) -%>

    <%-# Image metadata -%>
    <%- preview_image = meta_image -%>
    <%- preview_image_type = "image/png" -%>
    <%- preview_image_width = "1435" -%>
    <%- preview_image_height = "780" -%>
    <%- preview_image_alt =
      "A preview of #{specific_page_title.present? ? specific_page_title : site_name_text}" -%>

    <%-# Article metadata -%>
    <%- metadata = article_metadata(@article) -%>
    <%- published_date = metadata[:published_date] -%>
    <%- modified_date = metadata[:modified_date] -%>
    <%- author = metadata[:author] -%>
    <%- section = metadata[:section] -%>
    <%- article_tags = metadata[:tags] || [] -%>

    <%-# Icons -%>
    <%- favicon_path = vite_asset_path("~/images/favicon.jpg") -%>
    <!--Preconnects and DNS prefetches-->
    <link rel="dns-prefetch" href="r2.<%= domain %>">
    <link rel="preconnect" href="r2.<%= domain %>">
    <%= yield :specifcstylesheets %>
    <%= vite_stylesheet_tag "~/stylesheets/application.scss" %>
    <link
      rel="preload"
      href="<%= vite_asset_path("~/fonts/SpaceMono-Regular-subset.woff2") %>"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    >
    <script>
      // Site bundle owns Lenis on #crt-content; extension userscript skips when this is set.
      window._lenisInitialised = true;
    </script>
    <%= vite_javascript_tag "~/javascript/application.js" %>
    <!--Basic HTML metadata-->
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    >
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <% if published_date.present? %>
      <meta name="article:published_time" content="<%= published_date %>">
    <% end %>
    <% if modified_date.present? %>
      <meta name="article:modified_time" content="<%= modified_date %>">
    <% end %>
    <meta name="author" content="<%= author %>">
    <!--Title and icons-->
    <title><%= full_page_title %></title>
    <link rel="canonical" href="<%= current_url %>">
    <link rel="shortcut icon" href="<%= favicon_path %>" type="image/x-icon">
    <link rel="apple-touch-icon" href="<%= favicon_path %>" type="image/x-icon">
    <!--Mobile web app metadata-->
    <meta name="mobile-web-app-capable" content="no">
    <meta name="apple-mobile-web-app-capable" content="no">
    <meta name="apple-mobile-web-app-title" content="<%= site_name_text %>">
    <meta name="apple-mobile-web-app-status-bar-style" content="<%= theme_color %>">
    <!--Security headers-->
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!--Development only-->
    <%= vite_client_tag %>
  </head>
  <body>
    <% crt_displacement_map = vite_asset_path("~/images/crt-displacement-map.png") %>
    <div class="scanlines"></div>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      preserveAspectRatio="none"
      style="
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        contain: strict;
      "
    >
      <defs>
        <filter
          id="barrel"
          x="-50%"
          y="-50%"
          width="200%"
          height="200%"
          filterUnits="userSpaceOnUse"
          primitiveUnits="userSpaceOnUse"
          color-interpolation-filters="sRGB"
        >
          <feimage
            href="<%= crt_displacement_map %>"
            xlink:href="<%= crt_displacement_map %>"
            x="-50%"
            y="-50%"
            width="200%"
            height="200%"
            preserveAspectRatio="none"
            result="barrelImage"
          />
          <fegaussianblur
            in="barrelImage"
            stdDeviation="0.35"
            result="barrel"
          />
          <fedisplacementmap
            id="crt-displacement"
            in="SourceGraphic"
            in2="barrel"
            scale="50"
            xChannelSelector="R"
            yChannelSelector="G"
            edgeMode="duplicate"
            x="-50%"
            y="-50%"
            width="200%"
            height="200%"
          />
        </filter>
      </defs>
      <g filter="url(#barrel)">
        <foreignobject x="0" y="0" width="100%" height="100%">
          <div class="crt-shell" xmlns="http://www.w3.org/1999/xhtml">
          <div
            id="crt-content"
            data-controller="crt animation-visibility"
          >
      <%= render 'layouts/shortcutswrapper' do %>
        <%= render 'layouts/distractionmodewrapper' do %>
          <%= render 'layouts/leniswrapper' do %>
            <div class="layout-main">
              <header class="layout-header">
                <a href="/" class="layout-home-link" rel="noopener">George Baskerville</a>
                <% nav_items = [
                  { title: "Posts", path: "/posts", external: false },
                  { title: "Images", path: "/images", external: false },
                  { title: "Miscellaneous", path: "/miscellaneous", external: false },
                  { title: "Legal", path: "/legal", external: false },
                ] %>

                <nav class="layout-nav" data-controller="heading-highlight">
                  <ul>
                    <% nav_items.each do |item| %>
                      <li>
                        <% if item[:external] %>
                          <a
                            href="<%= item[:path] %>"
                            target="_self"
                            rel="noopener"
                            class="<%= 'text-accent' if !item[:external] && request.path == item[:path] %>"
                          >
                            <%= item[:title] %>
                          </a>
                        <% else %>
                          <a
                            href="<%= item[:path] %>"
                            class="<%= 'text-accent' if request.path == item[:path] %>"
                          >
                            <%= item[:title] %>
                          </a>
                        <% end %>
                      </li>
                    <% end %>
                    <li>
                      <button
                        class="distraction-button"
                        data-action="
                          click->distractionmode#toggleDistractionMode
                        "
                      >
                        ✨Distraction Mode✨
                      </button>
                    </li>
                  </ul>
                </nav>
              </header>
              <div class="flex-grow">
                <main>
                  <div class="main">
                    <%= yield %>
                    <%= render "layouts/footer" %>
                  </div>
                </main>
              </div>
            </div>
            <%= render "layouts/floatingwindows" %>
          <% end %>
        <% end %>
      <% end %>
          </div>
          <%= render "layouts/cursor" %>
          <%= render "layouts/oneko" %>
          </div>
        </foreignobject>
      </g>
    </svg>
    <div id="geor-me-extension-footer-slot" class="geor-me-extension-footer-slot" aria-hidden="true">
      <div style="width:98%;background:#1a1a1a;box-sizing:border-box;border-top-right-radius: 10px;border-top-left-radius: 10px;">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;padding:8px 16px;">
          <span style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;color:#999;">A <strong style="color:#ccc;font-weight:600;">geor.me</strong> project</span>
          <span style="display:flex;align-items:center;gap:12px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;">
            <a href="https://geor.me/licensing" style="color:#aaa;text-decoration:none;cursor:pointer;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;">Licensing</a>
            <span style="color:#444;">·</span>
            <a href="https://geor.me/privacy" style="color:#aaa;text-decoration:none;cursor:pointer;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;">Privacy</a>
            <span style="color:#444;">·</span>
            <a href="https://geor.me/dmca" style="color:#aaa;text-decoration:none;cursor:pointer;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;">DMCA</a>
          </span>
        </div>
      </div>
    </div>
  </body>
</html>
