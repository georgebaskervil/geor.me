<!DOCTYPE html>
<html lang="en-GB" dir="ltr">
  <head>
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    >
    <meta name="view-transition" content="same-origin">
    <%- full_page_title = page_title(page_specific_title(@article)) -%>
    <%- favicon_path = vite_asset_path("~/images/favicon.jpg") -%>
    <link rel="dns-prefetch" href="r2.<%= domain %>">
    <link rel="preconnect" href="r2.<%= domain %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Waiting+for+the+Sunrise&display=swap" rel="stylesheet">
    <%= vite_stylesheet_tag "~/stylesheets/entries/core.scss" %>
    <% Array(@route_stylesheet_entries).each do |entry| %>
      <%= vite_stylesheet_tag "~/stylesheets/#{entry}", data: { turbo_track: "reload" } %>
    <% end %>
    <script>
      // Early capability classes (refined by app/javascript/capabilities.js).
      // CRT is not gated on reduced-motion (static filter). Lenis is. Touch → native.
      (function () {
        try {
          var h = document.documentElement;
          var mq = function (q) {
            return window.matchMedia(q).matches;
          };
          var touchOnly =
            !mq("(hover: hover)") &&
            !mq("(any-pointer: fine)") &&
            (mq("(pointer: coarse)") || mq("(any-pointer: coarse)"));
          if (mq("(prefers-reduced-motion: reduce)") || touchOnly) {
            h.classList.add("geor-no-lenis");
          }
          if (touchOnly) h.classList.add("geor-no-cursor", "geor-no-oneko");
        } catch (e) {}
      })();
    </script>
    <%= vite_javascript_tag "~/javascript/application.js" %>
    <% crt_displacement_map = same_origin_vite_asset_path("~/images/crt-displacement-map.png") %>
    <link rel="preload" as="image" href="<%= crt_displacement_map %>">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <title><%= full_page_title %></title>
    <link rel="shortcut icon" href="<%= favicon_path %>" type="image/x-icon">
    <link rel="apple-touch-icon" href="<%= favicon_path %>" type="image/x-icon">
    <meta name="mobile-web-app-capable" content="no">
    <meta name="apple-mobile-web-app-capable" content="no">
    <meta name="apple-mobile-web-app-title" content="<%= site_name %>">
    <meta name="apple-mobile-web-app-status-bar-style" content="<%= theme_color %>">
    <%= csrf_meta_tags %>
    <%= action_cable_meta_tag %>
    <%= csp_meta_tag %>
    <%= vite_client_tag %>
  </head>
  <body>
    <div class="scanlines"></div>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      preserveAspectRatio="none"
      style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; contain: strict;"
    >
      <defs>
        <filter
          id="barrel"
          x="-50%"
          y="-50%"
          width="200%"
          height="200%"
          filterUnits="userSpaceOnUse"
          primitiveUnits="userSpaceOnUse"
          color-interpolation-filters="sRGB"
        >
          <feimage
            id="crt-displacement-image"
            href="<%= crt_displacement_map %>"
            xlink:href="<%= crt_displacement_map %>"
            x="-50%"
            y="-50%"
            width="200%"
            height="200%"
            preserveAspectRatio="none"
            result="barrelImage"
          />
          <fedisplacementmap
            id="crt-displacement"
            in="SourceGraphic"
            in2="barrelImage"
            scale="50"
            xChannelSelector="R"
            yChannelSelector="G"
            edgeMode="duplicate"
          />
        </filter>
      </defs>
      <g filter="url(#barrel)">
        <foreignobject id="crt-foreign-object" x="0" y="0" width="100%" height="100%">
          <div class="crt-shell" xmlns="http://www.w3.org/1999/xhtml">
            <div id="crt-content" data-controller="crt animation-visibility">
              <%= render 'layouts/shortcutswrapper' do %>
                  <%= render 'layouts/leniswrapper' do %>
                    <div
                      id="site-main"
                      class="layout-main"
                      data-turbo-transition="page"
                    >
                      <header class="layout-header">
                        <a href="/" class="layout-home-link" rel="noopener">George Baskerville</a>
                        <% nav_items = [
                          { title: "Posts", path: "/posts", external: false },
                          { title: "Images", path: "/images", external: false },
                          { title: "Projects", path: "/projects", external: false },
                          { title: "Miscellaneous", path: "/miscellaneous", external: false },
                        ] %>

                        <nav class="layout-nav" data-controller="heading-highlight">
                          <ul>
                            <% nav_items.each do |item| %>
                              <li>
                                <% if item[:external] %>
                                  <a
                                    href="<%= item[:path] %>"
                                    target="_self"
                                    rel="noopener"
                                    class="
                                      <%= 'text-accent' if !item[:external] && request.path == item[:path] %>
                                    "
                                  >
                                    <%= item[:title] %>
                                  </a>
                                <% else %>
                                  <a
                                    href="<%= item[:path] %>"
                                    class="
                                      <%= 'text-accent' if request.path == item[:path] %>
                                    "
                                  >
                                    <%= item[:title] %>
                                  </a>
                                <% end %>
                              </li>
                            <% end %>
                            <li>
                              <button
                                class="distraction-button"
                                data-controller="distractionmode-launcher"
                                data-distractionmode-launcher-scope-value="distractionmode-scope"
                                data-action="click->distractionmode-launcher#activate"
                              >
                                ✨Distraction Mode✨
                              </button>
                            </li>
                          </ul>
                        </nav>
                      </header>
                      <div class="flex-grow">
                        <main>
                          <div class="main">
                            <%= yield %>
                          </div>
                        </main>
                      </div>
                    </div>
                    <%= render "shared/geor_me_project_footer" %>
                  <% end %>
              <% end %>
            </div>
            <div id="distractionmode-scope">
              <%= render "layouts/floatingwindows" %>
            </div>
            <%= render "layouts/oneko" %>
            <%= render "layouts/cursor" %>
          </div>
        </foreignobject>
      </g>
    </svg>
  </body>
</html>
