<!DOCTYPE html>
<html lang="en-GB" dir="ltr">
  <head>
    <script src="https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?flags=gated&unknown=polyfill"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/phaser/3.90.0/phaser.min.js" integrity="sha384-AvQiDMZAVLda3VtAoU5MCfBz8pzXhteb2CiUJeKBmPlWzpXj1uJ96Km11+YuFNu/" crossorigin="anonymous"></script>
    <% if Rails.env.production? %>
      <script
        async
        defer
        src="/umami/script.js"
        data-website-id="77d51e44-cbc3-43da-8dd8-f4e21d38c495"
      ></script>
    <% end %>
    <%# Page metadata (using helper methods defined in ApplicationHelper) -%>
    <%- site_name_text = site_name -%>
    <%- specific_page_title = page_specific_title(@article) -%>
    <%- full_page_title = page_title(specific_page_title) -%>
    <%- page_description = meta_description(@article) -%>
    <%- page_keywords = meta_keywords(@article) -%>
    <%- content_type = page_type(@article) -%>
    <%- current_url = canonical_url(@article) -%>

    <%-# Image metadata -%>
    <%- preview_image = meta_image -%>
    <%- preview_image_type = "image/png" -%>
    <%- preview_image_width = "1435" -%>
    <%- preview_image_height = "780" -%>
    <%- preview_image_alt =
      "A preview of #{specific_page_title.present? ? specific_page_title : site_name_text}" -%>

    <%-# Article metadata -%>
    <%- metadata = article_metadata(@article) -%>
    <%- published_date = metadata[:published_date] -%>
    <%- modified_date = metadata[:modified_date] -%>
    <%- author = metadata[:author] -%>
    <%- section = metadata[:section] -%>
    <%- article_tags = metadata[:tags] || [] -%>

    <%-# Icons -%>
    <%- favicon_path = vite_asset_path("~/images/favicon.jpg") -%>
    <!--Preconnects and DNS prefetches-->
    <link rel="dns-prefetch" href="r2.<%= domain %>">
    <link rel="preconnect" href="r2.<%= domain %>">
    <%= yield :specifcstylesheets %>
    <%= vite_stylesheet_tag "~/stylesheets/application.scss" %>
    <link
      rel="preload"
      href="<%= vite_asset_path("~/fonts/SpaceMono-Regular-subset.woff2") %>"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    >
    <%= vite_javascript_tag "~/javascript/application.js" %>
    <!--Basic HTML metadata-->
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    >
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer-when-downgrade">
    <% if published_date.present? %>
      <meta name="article:published_time" content="<%= published_date %>">
    <% end %>
    <% if modified_date.present? %>
      <meta name="article:modified_time" content="<%= modified_date %>">
    <% end %>
    <meta name="author" content="<%= author %>">
    <!--Title and icons-->
    <title><%= full_page_title %></title>
    <link rel="canonical" href="<%= current_url %>">
    <link rel="shortcut icon" href="<%= favicon_path %>" type="image/x-icon">
    <link rel="apple-touch-icon" href="<%= favicon_path %>" type="image/x-icon">
    <!--Mobile web app metadata-->
    <meta name="mobile-web-app-capable" content="no">
    <meta name="apple-mobile-web-app-capable" content="no">
    <meta name="apple-mobile-web-app-title" content="<%= site_name_text %>">
    <meta name="apple-mobile-web-app-status-bar-style" content="<%= theme_color %>">
    <!--Security headers-->
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!--Development only-->
    <%= vite_client_tag %>
  </head>
  <body>
    <div class="scanlines"></div>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      preserveAspectRatio="none"
      style="
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        contain: strict;
      "
    >
      <defs>
        <filter
          id="barrel"
          x="-50%"
          y="-50%"
          width="200%"
          height="200%"
          filterUnits="userSpaceOnUse"
          primitiveUnits="userSpaceOnUse"
          color-interpolation-filters="sRGB"
        >
          <feimage
            id="filter-image"
            x="-50%"
            y="-50%"
            width="200%"
            height="200%"
            preserveAspectRatio="none"
            result="barrelImage"
          />
          <fegaussianblur
            in="barrelImage"
            stdDeviation="0.35"
            result="barrel"
          />
          <fedisplacementmap
            in="SourceGraphic"
            in2="barrel"
            scale="50"
            xChannelSelector="R"
            yChannelSelector="G"
            edgeMode="duplicate"
            x="-50%"
            y="-50%"
            width="200%"
            height="200%"
          />
        </filter>
      </defs>
      <g filter="url(#barrel)">
        <foreignobject x="-10%" y="-10%" width="120%" height="120%">
          <div id="crt-content" xmlns="http://www.w3.org/1999/xhtml" style="transform: scale(0.833); transform-origin: center center; width: 100%; height: 100%; overflow-y: auto;">
            <%= render 'layouts/shortcutswrapper' do %>
              <%= render 'layouts/distractionmodewrapper' do %>
                <%= render 'layouts/leniswrapper' do %>
                  <div class="layout-main">
                    <header class="layout-header">
                      <a href="/" class="layout-home-link" rel="noopener">George Baskerville</a>
                      <% nav_items = [
                        { title: "Posts", path: "/posts", external: false },
                        { title: "Images", path: "/images", external: false },
                        { title: "Miscellaneous", path: "/miscellaneous", external: false },
                        { title: "Legal", path: "/legal", external: false },
                      ] %>

                      <nav class="layout-nav" data-controller="heading-highlight">
                        <ul>
                          <% nav_items.each do |item| %>
                            <li>
                              <% if item[:external] %>
                                <a
                                  href="<%= item[:path] %>"
                                  target="_self"
                                  rel="noopener"
                                  class="<%= 'text-accent' if !item[:external] && request.path == item[:path] %>"
                                >
                                  <%= item[:title] %>
                                </a>
                              <% else %>
                                <a
                                  href="<%= item[:path] %>"
                                  class="<%= 'text-accent' if request.path == item[:path] %>"
                                >
                                  <%= item[:title] %>
                                </a>
                              <% end %>
                            </li>
                          <% end %>
                          <li>
                            <button
                              class="distraction-button"
                              data-action="
                                click->distractionmode#toggleDistractionMode
                              "
                            >
                              ✨Distraction Mode✨
                            </button>
                          </li>
                        </ul>
                      </nav>
                    </header>
                    <div class="flex-grow">
                      <main>
                        <div class="main">
                          <%= yield %>
                          <%= render "layouts/footer" %>
                        </div>
                      </main>
                    </div>
                  </div>
                <% end %>
                <%= render "layouts/floatingwindows" %>
              <% end %>
            <% end %>
          </div>
        </foreignobject>
      </g>
    </svg>
    <%= render "layouts/cursor" %>
    <%= render "layouts/oneko" %>
    <canvas id="crt-canvas" style="display: none"></canvas>
    <script>
      "use strict";
      var canvas = document.getElementById("crt-canvas");
      var barrel = document.getElementById("filter-image");
      var displacement = document.querySelector("fedisplacementmap");
      var size = 512;
      canvas.width = size;
      canvas.height = size;
      var c = size / 2;
      var ctx = canvas.getContext("2d");
      var imageData = ctx.createImageData(size, size);
      var data = imageData.data;
      for (var y = 0; y < size; y++) {
        for (var x = 0; x < size; x++) {
          var dx = x - c;
          var dy = y - c;
          var l = Math.sqrt(dx * dx + dy * dy);
          var t = Math.min(l / c, 1);
          var factor = t * t * 0.7;
          var r = 128 + dx * factor;
          var g = 128 + dy * factor;
          var idx = (y * size + x) << 2;
          data[idx] = r < 0 ? 0 : r > 255 ? 255 : r | 0;
          data[idx + 1] = g < 0 ? 0 : g > 255 ? 255 : g | 0;
          data[idx + 2] = 0;
          data[idx + 3] = 255;
        }
      }
      ctx.putImageData(imageData, 0, 0);
      var dataUrl = canvas.toDataURL();
      barrel.setAttributeNS(
        "http://www.w3.org/1999/xlink",
        "xlink:href",
        dataUrl,
      );
      barrel.setAttribute("href", dataUrl);
      var resizeTimer;
      function updateScale() {
        try {
          var base_scale = 80;
          var strength = 0.95;
          var current_scale =
            base_scale * (window.innerWidth / 1024) * strength;
          displacement.setAttribute("scale", current_scale);
        } catch (e) {
          // Element not found, ignore error
        }
      }
      updateScale();
      window.addEventListener("resize", function() {
        if (resizeTimer) return;
        resizeTimer = requestAnimationFrame(function() {
          resizeTimer = null;
          updateScale();
        });
      });
    </script>
  </body>
</html>
