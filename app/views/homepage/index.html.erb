<article class="hp-article">
  <div class="hp-rows">
    <div class="hp-columns">
      <h1 class="hp-h1">
        👋 Hi, I'm George
      </h1>
      <h2 class="hp-h2">
        Mad (computer) scientist. That's it. That's the bio. (I did make my
        first site
        <span data-live-time-since>
          <% duration = Time.now - Time.new(2019, 5, 7)
          years = (duration / (86_400 * 365)).to_i
          remaining_days = duration % (86_400 * 365)
          months = (remaining_days / (86_400 * 30)).to_i
          days = ((remaining_days % (86_400 * 30)) / 86_400).to_i %>
          <%= years %>
          years,
          <%= months %>
          months, and
          <%= days %>
          days
        </span>
        ago though!)
      </h2>
      <% social_links = [
        { name: "X", url: "https://x.com/georgebaskervil" },
        {
          name: "Signal",
          url:
            "https://signal.me/#eu/Ui1-KTmlgnCbNj491iq3HSOJtrkY1aVHm4n0v97dvkGDbCqWsExOu66Fzg7-7iC9",
        },
        { name: "GitHub", url: "https://github.com/georgebaskervil" },
        { name: "Email", url: "mailto:me@geor.me" },
      ] %>
      <div class="hp-custom-breadcrumbs hp-li-div">
        <ul>
          <% social_links.each do |link| %>
            <li>
              <a href="<%= link[:url] %>" target="_self" rel="noopener" class="text-accent">
                <%= link[:name] %>
              </a>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
    <div class="hp-image-container hp-picture">
      <%= image_tag(
        vite_asset_path("~/images/me.avif"),
        alt: "A picture of me",
        loading: "eager",
        width: "654",
        height: "654",
        decoding: "async",
        fetchpriority: "high",
      ) %>
    </div>
  </div>
</article>
<article class="hp-article-2">
  <header class="hp-header-2">
    <h3 class="hp-h3">My best OSS projects:</h3>
    <a
      href="https://github.com/georgebaskervil?tab=repositories"
      class="hp-small-link"
      target="_self"
      rel="noreferrer"
    >
      See all projects
    </a>
  </header>
  <!-- Interactive Project Carousel -->
  <section class="hp-project-carousel">
    <% current_site_url = request.base_url %>
    <% featured_projects = [
      {
        title: "Libreverse",
        description: "My open-source metaverse project.",
        partial: "libreverse/content",
        background: "#0e0e0e",
        # Heavy WebGL iframe — keep it mounted across slide changes instead of
        # recreating it (reload cost >> keeping a hidden frame in memory).
        persist: true,
      },
      {
        title: "RobusText",
        link_url: "/robustext",
        description:
          "A text editor designed to handle malformed unicode characters gracefully.",
        partial: "robustext/content",
        background: "#161820",
      },
      {
        title: "TaskStack",
        link_url: "/taskstack",
        description: "A todo list app I made custom for the way I work.",
        partial: "taskstack/content",
        background: "#16181f",
      },
      {
        title: "Georlist",
        description:
          "A web service that compiles all the dns blocklists I use into one.",
        partial: "georlist/content",
        background: "#16181f",
      },
      {
        title: "uwuifier",
        description:
          "A Python project that uses stable diffusion to synthesise anime-style profile pictures.",
        partial: "uwuifier/content",
        background: "#16181f",
      },
      {
        title: "SpaceShooter",
        link_url: "/spaceshooter",
        description:
          "A simple 2D space shooter game generated by Grok 3 with Gosu.",
        partial: "spaceshooter/content",
        background: "#000000",
      },
      {
        title: "Home Control Panel",
        link_url: "/homecontrolpanel",
        description: "A smart home control panel",
        partial: "home_control/content",
        background: "#16181f",
      },
    ] %>

    <div
      class="carousel-container"
      data-controller="project-carousel"
      data-action="
        mouseenter->project-carousel#pauseAutoAdvance
        mouseleave->project-carousel#resumeAutoAdvance
      "
    >
      <div class="carousel-wrapper">
        <div class="carousel-slides" data-project-carousel-target="slides">
          <% featured_projects.each_with_index do |project, index| %>
            <%= tag.div(
              class: "carousel-slide #{'active' if index == 0}",
              data: { project_carousel_target: "slide", slide: index },
              style: ("background-color: #{project[:background]}" if project[:background])
            ) do %>
              <div class="project-info">
                <div class="project-content">
                  <h5 class="project-title"><%= project[:title] %></h5>
                  <p class="project-description"><%= project[:description] %></p>
                </div>
                <div class="project-nav-btns">
                  <button
                    class="project-link-btn"
                    data-action="click->project-carousel#previous"
                    aria-label="Previous project"
                  >
                    ←
                  </button>
                  <button
                    class="project-link-btn"
                    data-action="click->project-carousel#next"
                    aria-label="Next project"
                  >
                    →
                  </button>
                </div>
              </div>
              <% if project[:partial] %>
                <%= tag.div(
                  class: "carousel-embed-container",
                  data: (project[:persist] ? { carousel_persist: true } : {})
                ) do %>
                  <%= render project[:partial] %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </section>
</article>

<article class="hp-spacing">
  <header class="hp-header">
    <h3 class="hp-h3">Some of the best photos I have taken:</h3>
    <a href="/images" class="hp-small-link" rel="noopener">
      See all photos
    </a>
  </header>
  <section class="hp-image-grid-container">
    <% @images.first(8).each_with_index do |img, index| %>
      <div class="image-container">
        <%# `img` here is already the basename without extension, e.g. "resized_DSC_0019" %>
        <% base_name = img %>
        <% avif_name = "#{base_name}.avif" %>
        <% jpg_name = "#{base_name.sub(/^resized_/, "")}.JPG" %>
        <a href="<%= vite_asset_path("~/losslessphotos/#{jpg_name}") %>" target="_self">
          <%= image_tag(
            vite_asset_path("~/photos/AVIFs/#{avif_name}"),
            loading: "lazy",
            decoding: "async",
            fetchpriority: "low",
          ) %>
        </a>
      </div>
    <% end %>
  </section>
</article>

<article>
  <header class="hp-header">
    <h3 class="hp-h3">The latest blog posts I have written:</h3>
    <a href="/posts" class="hp-small-link" rel="noopener">
      See all posts
    </a>
  </header>
  <section class="posts-section">
    <% @latest_posts.each do |article| %>
      <% if article[:format] == :feed %>
        <%= link_to article[:external_url], class: "posts-card", target: "_blank", rel: "noopener" do %>
          <h2 class="posts-title"><%= article[:title] %></h2>
          <p class="posts-content"><%= article[:description] %></p>
          <p class="posts-published-date-card-ver">Published on
            <%= article[:published_at].strftime("%B %d, %Y") %></p>
        <% end %>
      <% elsif article[:format] == :pdf %>
        <%= link_to post_path(article[:slug]), class: "posts-card", data: { turbo: false } do %>
          <h2 class="posts-title"><%= article[:title] %></h2>
          <p class="posts-content"><%= article[:description] %></p>
          <p class="posts-published-date-card-ver">Published on
            <%= article[:published_at].strftime("%B %d, %Y") %></p>
        <% end %>
      <% else %>
        <%= link_to post_path(article[:slug]), class: "posts-card" do %>
          <h2 class="posts-title"><%= article[:title] %></h2>
          <p class="posts-content"><%= article[:description] %></p>
          <p class="posts-published-date-card-ver">Published on
            <%= article[:published_at].strftime("%B %d, %Y") %></p>
        <% end %>
      <% end %>
    <% end %>
  </section>
</article>
