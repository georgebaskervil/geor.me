<article class="hp-article">
  <div class="hp-rows">
    <div class="hp-columns">
      <h1 class="hp-h1">
        👋 Hi, I'm George
      </h1>
      <h2 class="hp-h2">
        Software, synthesisers, and the occasional photograph. Made my first website
        <span data-live-time-since>
          <% duration = Time.now - Time.new(2019, 5, 7)
          years = (duration / (86_400 * 365)).to_i
          remaining_days = duration % (86_400 * 365)
          months = (remaining_days / (86_400 * 30)).to_i
          days = ((remaining_days % (86_400 * 30)) / 86_400).to_i %>
          <%= years %>
          years,
          <%= months %>
          months, and
          <%= days %>
          days
        </span>
        ago.
      </h2>
      <% social_links = [
        { name: "X", url: "https://x.com/georgebaskervil" },
        {
          name: "Signal",
          url:
            "https://signal.me/#eu/Ui1-KTmlgnCbNj491iq3HSOJtrkY1aVHm4n0v97dvkGDbCqWsExOu66Fzg7-7iC9",
        },
        { name: "GitHub", url: "https://github.com/georgebaskervil" },
        { name: "Email", url: "mailto:me@geor.me" },
      ] %>
      <div class="hp-custom-breadcrumbs hp-li-div">
        <ul>
          <% social_links.each do |link| %>
            <li>
              <a href="<%= link[:url] %>" target="_self" rel="noopener" class="text-accent">
                <%= link[:name] %>
              </a>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
    <div class="hp-image-container profile-tilt">
      <!-- data-controller="tilt" moves the 3D mouse-follow tilt + glow into the reusable Stimulus controller.
           data-super-hover ensures super-hover (always-running) drives [data-super-hover-active] for the hover styles. -->
      <div class="profile-card" data-controller="tilt" data-super-hover>
        <%= image_tag(
          vite_asset_path("~/images/pfp.png"),
          alt: "A picture of me",
          loading: "eager",
          width: "498",
          height: "498",
          decoding: "async",
          fetchpriority: "high",
        ) %>
        <div class="glow"></div>
      </div>
    </div>
  </div>
</article>
